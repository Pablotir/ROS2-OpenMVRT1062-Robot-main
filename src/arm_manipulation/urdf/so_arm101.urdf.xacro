<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so_arm101">

  <!-- Properties -->
  <xacro:property name="M_PI" value="3.14159265359"/>
  <xacro:property name="base_width" value="0.08"/>
  <xacro:property name="base_height" value="0.04"/>
  <xacro:property name="shoulder_height" value="0.170"/>
  <xacro:property name="l1_len" value="0.115"/>
  <xacro:property name="l2_len" value="0.1375"/>
  <xacro:property name="l3_len" value="0.090"/>
  <xacro:property name="link_width" value="0.04"/>
  <xacro:property name="mass_typical" value="0.055"/>

  <!-- Materials -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.1 0.8 1"/>
  </material>
  <material name="green">
    <color rgba="0.1 0.8 0.1 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1"/>
  </material>
  <material name="yellow">
    <color rgba="0.8 0.8 0.1 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <!-- Macro for inertia -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m w d h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(d*d+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(w*w+h*h)/12}" iyz="0"
               izz="${m*(w*w+d*d)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- BASE LINK -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_width} ${base_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${mass_typical*2}" w="${base_width}" d="${base_width}" h="${base_height}"/>
  </link>

  <!-- SHOULDER PAN LINK -->
  <link name="shoulder_pan_link">
    <visual>
      <origin xyz="0 0 ${(shoulder_height - base_height)/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="${shoulder_height - base_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${(shoulder_height - base_height)/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="${shoulder_height - base_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${mass_typical}" r="0.03" h="${shoulder_height - base_height}"/>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_pan_link"/>
    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- limits [-113.8°, +113.8°] -> +/- 1.986 rad -->
    <limit lower="-1.986" upper="1.986" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- SHOULDER LIFT LINK -->
  <link name="shoulder_lift_link">
    <visual>
      <origin xyz="0 0 ${l1_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link_width} ${link_width} ${l1_len}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l1_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link_width} ${link_width} ${l1_len}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${mass_typical}" w="${link_width}" d="${link_width}" h="${l1_len}"/>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_pan_link"/>
    <child link="shoulder_lift_link"/>
    <origin xyz="0 0 ${shoulder_height - base_height}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- limits [-110°, +150°] -> [-1.919, +2.618] -->
    <limit lower="-1.919" upper="2.618" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- ELBOW LINK -->
  <link name="elbow_link">
    <visual>
      <origin xyz="0 0 ${l2_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link_width} ${link_width} ${l2_len}"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l2_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link_width} ${link_width} ${l2_len}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${mass_typical}" w="${link_width}" d="${link_width}" h="${l2_len}"/>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_lift_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 ${l1_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- limits [-120°, +120°] -> +/- 2.094 rad -->
    <limit lower="-2.094" upper="2.094" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- WRIST FLEX LINK -->
  <link name="wrist_flex_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${mass_typical}" r="0.02" h="0.04"/>
  </link>

  <joint name="wrist_flex_joint" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_flex_link"/>
    <origin xyz="0 0 ${l2_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- limits [-120°, +120°] -> +/- 2.094 rad -->
    <limit lower="-2.094" upper="2.094" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- WRIST ROLL LINK -->
  <link name="wrist_roll_link">
    <visual>
      <origin xyz="0 0 ${l3_len/4}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="${l3_len/2}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l3_len/4}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="${l3_len/2}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${mass_typical}" r="0.015" h="${l3_len/2}"/>
  </link>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_flex_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- limits [-180°, +180°] -> +/- 3.14159 rad -->
    <limit lower="-3.14159" upper="3.14159" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- GRIPPER LINK -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 ${l3_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.02 0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l3_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.02 0.05"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${mass_typical}" w="0.06" d="0.02" h="0.05"/>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="wrist_roll_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 ${l3_len/2}" rpy="0 0 0"/>
  </joint>

  <!-- CAMERA MOUNT -->
  <link name="camera_mount_link"/>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="wrist_flex_link"/>
    <child link="camera_mount_link"/>
    <!-- 50mm above wrist center, 45 deg pitch down -->
    <!-- Pitch rotation by 45 degrees (0.785 rad) around Y axis -->
    <origin xyz="0.035 0 0.050" rpy="0 0.785 0"/>
  </joint>

  <link name="camera_link"/>
  
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
